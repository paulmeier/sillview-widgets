{
  "name": "sillview-widgets",
  "version": "0.1.0",
  "private": true,
  "description": "Community widget registry for the sillview dashboard.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild cli/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/cli.mjs --banner:js='#!/usr/bin/env node'",
    "validate": "npm run build && node dist/cli.mjs validate",
    "index": "npm run build && node dist/cli.mjs index",
    "index:check": "npm run build && node dist/cli.mjs index --check",
    "seed": "node scripts/seed-builtins.mjs",
    "lint": "eslint --ext .ts cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "smol-toml": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
